# Copy to .env and fill in. Never commit the real .env.

PORT=5000

# Include the database name before the query string, or Mongoose silently
# uses a database called "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jewellery?appName=Cluster0

# Long random string. In production a missing value is a hard startup failure.
JWT_SECRET=
JWT_EXPIRE=30d

UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

NODE_ENV=production

# Required when the SPA is on a different subdomain than the API. Comma-separated
# origins, scheme included, no trailing slash.
CORS_ORIGIN=https://jewellery.adityagajmer.com.np

# Per-shop subdomains. Leave EMPTY for the normal single-domain setup — every
# shop signs in at one address and the tenant comes from the JWT. Setting this
# without wildcard DNS and the on-demand TLS Caddyfile locks shop users out.
APP_BASE_DOMAIN=
APP_MAIN_SUBDOMAIN=jewellery
