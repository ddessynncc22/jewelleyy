# Static file server INSIDE the frontend container only.
#
# This is not your VPS Caddyfile. It listens on plain HTTP :80 inside the
# container and does no TLS — your Caddy on the VPS terminates HTTPS and
# reverse-proxies to it. You should not need to touch this file.

:80 {
	root * /srv
	encode gzip

	# Hashed filenames, safe to cache indefinitely.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback — client-side routes are not real files, so anything not
	# found on disk must return index.html rather than 404.
	try_files {path} /index.html
	file_server
}
